# ---- Database (Neon Postgres, pooled connection string) ----
DATABASE_URI=postgres://user:password@host/dbname?sslmode=require

# ---- Payload ----
# Long random string. Generate with: openssl rand -base64 32
PAYLOAD_SECRET=

# Public base URL of the deployed site (used for CORS/CSRF and absolute URLs).
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# ---- Cloudflare R2 (S3-compatible image storage) ----
S3_BUCKET=
S3_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Public delivery base for images (r2.dev URL or a custom domain), no trailing slash.
NEXT_PUBLIC_R2_PUBLIC_URL=https://<your-public-bucket-domain>

# ---- Contact form (FormSubmit) ----
# Server-only. After the first live submission + email confirmation, replace
# the raw email with the random alias FormSubmit returns to keep it private.
CONTACT_ALIAS=
